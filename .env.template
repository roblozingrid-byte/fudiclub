# ==============================================================================
# FUDI CLUB — Variables de Entorno (.env.template)
# ==============================================================================
# Copiá este archivo como ".env" para desarrollo local y como ".env.prod" para
# producción. NUNCA subas .env ni .env.prod a git.
#
# Para producción (Cloudflare Pages), estas variables van al panel:
#   Workers & Pages → fudi-club → Settings → Environment Variables
# ==============================================================================


# ------------------------------------------------------------------------------
# FRONTEND (Vite) — solo variables con prefijo VITE_ son expuestas al browser
# ------------------------------------------------------------------------------

# URL base de las Edge Functions de Supabase
# Local:      http://127.0.0.1:54321/functions/v1
# Producción: https://<tu-proyecto>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=

# Clave pública (anon) de Supabase — segura para exponer en el frontend
VITE_SUPABASE_ANON_KEY=


# ------------------------------------------------------------------------------
# SUPABASE EDGE FUNCTIONS (Deno) — solo disponibles server-side
# ------------------------------------------------------------------------------

# URL del proyecto Supabase (ej: https://xyzxyz.supabase.co)
SUPABASE_URL=

# Clave de rol de servicio — NUNCA exponer en el frontend
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# RESEND — Servicio de envío de emails
# ------------------------------------------------------------------------------

# API Key de Resend (re_xxxxxxxxxxxxxxxxxxxxxxxx)
RESEND_API_KEY=

# Dirección de remitente verificada en Resend
RESEND_FROM_EMAIL=Fudi Club <hola@fudiclub.shop>


# ------------------------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------------------------

# Access Token de Mercado Pago (APP_USR-xxxxxxxxxx)
MP_ACCESS_TOKEN=


# ------------------------------------------------------------------------------
# GOOGLE SHEETS — Sincronización automática desde Supabase Webhooks
# ------------------------------------------------------------------------------

# ID del Google Spreadsheet (lo encontrás en la URL del Sheet)
# Ej: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# JSON completo de la Service Account de Google (como string en una sola línea)
# Se obtiene desde Google Cloud Console → IAM → Service Accounts → Claves
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Nombres de las pestañas del Google Sheet (ya tienen valores por defecto en el código)
SHEETS_TAB_CUSTOMERS=Clientes (Backup)
SHEETS_TAB_ORDERS=Pedidos (Backup)
SHEETS_TAB_LEADS=Leads
